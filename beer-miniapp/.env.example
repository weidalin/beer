# 微信小程序
VITE_WX_APPID=wxedd798eb9ee923af

# 微信云开发环境 ID（与开发者工具「云开发」里当前小程序下的环境一致）
# 默认运行时优先使用 wx.cloud.DYNAMIC_CURRENT_ENV（与工具里选中的环境一致），.env 填错也不易 INVALID_ENV
VITE_CLOUD_ENV_ID=
# 必须写死只用下面这一行、不要用工具当前环境时设为 1 并重新 build
# VITE_CLOUD_ENV_FORCE_EXPLICIT=1

# 管理员 openid（本地备忘；init_db 不会读此文件，预设见 cloudbase/init.js 中 SEED_ADMIN_OPENIDS）
ADMIN_OPEN_ID=
# 多个管理员：英文逗号分隔（云函数环境变量可用 ADMIN_OPEN_IDS）
# ADMIN_OPEN_IDS=oXXX,oYYY

# Supabase（须带 https://，否则打包后会报 Invalid supabaseUrl）
VITE_SUPABASE_URL=https://你的项目.supabase.co
VITE_SUPABASE_ANON_KEY=你的anon密钥

# 腾讯地图（小程序地图组件）
VITE_TMAP_KEY=你的腾讯地图Key

# 供应商联系方式
VITE_CONTACT_PHONE=13800000000
VITE_CONTACT_WECHAT=jiuhaocang
